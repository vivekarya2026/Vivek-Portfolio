# ── Appwrite ─────────────────────────────────────────────────────────────────
# Create a project at https://cloud.appwrite.io, then copy these values from
# Project Settings.

NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=YOUR_PROJECT_ID

# API key (Server SDK / node-appwrite) — never expose to the browser.
# Create under Project Settings → API Keys with full database + storage access.
APPWRITE_API_KEY=YOUR_API_KEY

# IDs created by cms/scripts/appwrite-setup.ts (or manually in the console)
APPWRITE_DATABASE_ID=portfolio-cms
APPWRITE_BUCKET_ID=media

# ── Public URL ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
REVALIDATE_SECRET=dev-secret

# ── Contact form → email (Resend: https://resend.com/api-keys) ───────────────
RESEND_API_KEY=re_xxxxxxxx
ADMIN_EMAIL=aryavivekiitbhu@gmail.com
# Until you verify a custom domain in Resend, use their onboarding sender:
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>
# Comma-separated origins allowed to POST to /api/contact (your static site)
CONTACT_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Optional override for the form action written by build:site
# CONTACT_API_URL=https://your-cms.vercel.app/api/contact

# ── Auto-rebuild the public site after CMS publish/edit ──────────────────────
# Option A (preferred if Git is linked on the site Vercel project):
# SITE_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/prj_xxx/xxx
#
# Option B (used in this repo): GitHub PAT with repo scope → repository_dispatch
# triggers .github/workflows/rebuild-site.yml → vercel deploy --prod
# GITHUB_REBUILD_TOKEN=ghp_xxxxxxxx
# GITHUB_REBUILD_REPO=vivekarya2026/Vivek-Portfolio

# ── Legacy Supabase (needed only for the one-time data migration script) ──────
# Remove after running cms/scripts/migrate-supabase-to-appwrite.ts
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
